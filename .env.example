# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and update with your actual credentials.
# NEVER commit .env.local with real credentials to Git!

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hbd_memories?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hbd_memories?retryWrites=true&w=majority

# Optional: Specific Database Name (defaults to hbd_memories or the database in the URI)
MONGODB_DB=hbd_memories

# Optional: Next.js public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
